#!name=YouTube 手机版增强 0.5.1 Legacy
#!desc=兼容 Loon 3.5.1(982) 及更早版本：YouTube 移动网页版去展示广告、自动跳过视频广告、增加下载按钮。
#!author=sl00p / Loon legacy port
#!tag=YouTube,去广告,增强

[Script]
http-response ^https:\/\/m\.youtube\.com\/ requires-body=true,max-size=0,script-path=https://raw.githubusercontent.com/efzb-wx/loon/refs/heads/main/YoutubeBlock/YouTubeMobileInject.js,timeout=10,tag=YouTube手机版网页注入,enable=true

[MITM]
hostname = m.youtube.com
