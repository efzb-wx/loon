#!name=YouTube HD Plus
#!desc=Inject YouTube HD Plus UserScript into YouTube web pages via Loon
#!author=Converted for Loon
#!homepage=https://github.com/fznhq/userscript-collection

[Script]
http-response ^https:\/\/(www|m|music)\.youtube\.com\/.* script-path=https://raw.githubusercontent.com/efzb-wx/loon/refs/heads/main/YoutubeBlock/YouTube-HD-Plus-Loon.js, requires-body=true, timeout=20, tag=YouTube HD Plus
http-response ^https:\/\/www\.youtube-nocookie\.com\/.* script-path=https://raw.githubusercontent.com/efzb-wx/loon/refs/heads/main/YoutubeBlock/YouTube-HD-Plus-Loon.js, requires-body=true, timeout=20, tag=YouTube HD Plus Embed

[MITM]
hostname = www.youtube.com, m.youtube.com, music.youtube.com, www.youtube-nocookie.com

